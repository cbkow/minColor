      if (ed) { var en = normalizeSpace(ed, ctx.valid, ctx.family); if (en === "working") return { space: null, why: "extension rule: identity" }; if (en) return { space: en, why: "extension rule" }; return { space: null, why: "extension rule '" + ed + "' not in config — skipped" }; }
