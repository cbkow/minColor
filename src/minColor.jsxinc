// minColor.jsxinc — core v0 library (no compiled code; AE 26.x, OCIO mode).
// Depends on AEPPatch.jsxinc being included first.
// Facts and constraints this encodes are documented in ../PREPLAN.md and ../probes/RESULTS.md.

var MinColor = (function () {
  var VERSION = "0.8.0";
  var ROOT = new File($.fileName).parent.parent.fsName;            // repo root (src/..)
  var DIST = ROOT + "/config/dist";
  var STICKY_SEC = "After Effects Sticky Prefs", STICKY_KEY = "AE Last Project Settings";

  function readJSON(path) {
    var f = new File(path); if (!f.open("r")) throw new Error("cannot read " + path);
    var s = f.read(); f.close();
    return eval("(" + s + ")");                                     // ES3: no JSON.parse; our own trusted files only
  }
  function payload() { return readJSON(payloadRoot() + "/presets.json"); }
  function presets() { return payload().presets; }
  function presetMeta(key) {                                         // live OR retired record (retired carries retired:true), else null
    if (!key) return null;
    var j = payload();
    if (j.presets[key]) return j.presets[key];
    if (j.retired && j.retired[key]) { var r = j.retired[key]; r.retired = true; return r; }
    return null;
  }
  function currentPresetKey() { try { var i = sidecarInfo(); return i ? i.preset : null; } catch (e) { return null; } }
  function familyFor(key) {                                          // "Linear" | "Display"; unknown key -> infer from AE's working label
    var m = presetMeta(key); if (m && m.family) return m.family;
    var ws = ""; try { ws = app.project.workingSpace || ""; } catch (e) {}
    return (ws.indexOf("Display/") === 0) ? "Display" : "Linear";
  }
  var __cfgSpacesCache = { key: null, set: null };
  function configSpaces(path) {                                      // colourspace names + aliases of a config file (cached); null when unreadable
    try {
      if (!path) return null;
      var f = new File(path); if (!f.exists) return null;
      var key = f.fsName + "|" + f.length;
      if (__cfgSpacesCache.key === key) return __cfgSpacesCache.set;
      if (!f.open("r")) return null;
      var s = f.read(); f.close();
      var set = {}, re = /^    name: (.+)$/gm, m;
      while ((m = re.exec(s)) !== null) set[m[1].replace(/^\s+|\s+$/g, "")] = true;
      var ra = /^    aliases: \[([^\]]*)\]/gm;
      while ((m = ra.exec(s)) !== null) { var parts = m[1].split(","); for (var i = 0; i < parts.length; i++) { var a = parts[i].replace(/^\s+|\s+$/g, "").replace(/^"|"$/g, ""); if (a) set[a] = true; } }
      __cfgSpacesCache = { key: key, set: set };
      return set;
    } catch (e) { return null; }
  }
  function pinnedSpaces() { try { return configSpaces(app.project.ocioConfigurationFile); } catch (e) { return null; } }
  function pinBehind() {                                             // {pinned, current} when the project's pin is an OLDER hash of its preset's config, else null
    try {
      var info = sidecarInfo(); if (!info || !info.pinned) return null;
      var pr = presets()[info.preset]; if (!pr) return null;
      var base = info.pinned.replace(/\\/g, "/"); base = base.substring(base.lastIndexOf("/") + 1);
      return (base !== pr.config) ? { pinned: base, current: pr.config } : null;
    } catch (e) { return null; }
  }
  function menuLists(presetKey) {                                    // PER-PRESET menus; top-level lists = linear-family fallback (untitled / unmanaged)
    var j = payload(), pr = presetKey ? j.presets[presetKey] : null;
    var inp = (pr && pr.inputSpaces) || j.inputSpaces || [];
    var view = (pr && pr.viewSpaces) || j.viewSpaces || [];
    var voList = (pr && pr.viewOnly) || j.viewOnly || [], vo = {}, v;
    for (v = 0; v < voList.length; v++) vo[voList[v]] = true;
    var render = (pr && pr.renderSpaces) || j.renderSpaces || null;   // top-level render list carries the render-only targets too
    if (!render) { var seen = {}, all = view.concat(inp); render = []; for (var i = 0; i < all.length; i++) if (!seen[all[i]]) { seen[all[i]] = 1; render.push(all[i]); } }
    var out = []; for (var r = 0; r < render.length; r++) if (!vo[render[r]]) out.push(render[r]);
    /* a project pinned to an OLDER hash of this preset may lack spaces the current config has: the
       menus follow the PINNED config, never the payload, so nothing is offered that would render
       as pass-through ("unknown space") */
    var behind = pr ? pinBehind() : null, ps = behind ? pinnedSpaces() : null;
    if (ps) { var keep = function (l) { var o2 = []; for (var i2 = 0; i2 < l.length; i2++) if (ps[l[i2]]) o2.push(l[i2]); return o2; }; inp = keep(inp); view = keep(view); out = keep(out); }
    var rt = (!pr && presetKey && j.retired && j.retired[presetKey]) ? j.retired[presetKey] : null;   // retired: fallback lists, but its own family
    return { inputSpaces: inp, viewSpaces: view, renderSpaces: out, viewOnly: voList, family: pr ? pr.family : (rt ? rt.family : "Linear"), preset: pr ? presetKey : null, pinBehind: behind };
  }

  // ---------- payload discovery / sidecar / doctor ----------
  var SHARED_ROOT = ($.os.indexOf("Windows") >= 0) ? "C:/ProgramData/minColor" : "/Users/Shared/minColor";
  // Distribution shape: the panel looks for its data NEXT TO ITSELF first ("copy minColor.jsx and
  // minColor-data/ into your ScriptUI Panels folder" — AE's Window menu ignores jsx-less folders),
  // then the machine-wide root (facility installs), then the dev repo. Script-adjacent wins so a
  // shipped panel and its data can never version-skew.
  var SCRIPT_DATA = (function () { try { var d = new File($.fileName).parent.fsName + "/minColor-data"; return new Folder(d).exists ? d : null; } catch (eD) { return null; } })();
  function payloadRoot() {                                           // where template configs come FROM
    var cands = [];
    if (SCRIPT_DATA) cands.push(SCRIPT_DATA + "/configs");
    cands.push(SHARED_ROOT + "/configs", DIST);
    for (var i = 0; i < cands.length; i++) if (new File(cands[i] + "/presets.json").exists) return cands[i];
    throw new Error("minColor payload not found (looked in " + cands.join(", ") + ")");
  }
  function copyTree(srcFolder, dstFolder) {
    var src = new Folder(srcFolder), dst = new Folder(dstFolder);
    if (!dst.exists) dst.create();
    var kids = src.getFiles();
    for (var i = 0; i < kids.length; i++) {
      if (kids[i] instanceof Folder) copyTree(kids[i].fsName, dstFolder + "/" + kids[i].name);
      else { var target = new File(dstFolder + "/" + kids[i].name); if (!target.exists) kids[i].copy(target.fsName); }
    }
  }
  function sidecarDir() { var p2 = app.project; if (!p2.file) return null; return p2.file.parent.fsName + "/_minColor"; }
  // ---------- central config store (2026-08-27): configs live beside the plugin in MediaCore ----------
  // Projects pin the central path by default; the sidecar is materialized only for handoff/archive.
  var CENTRAL_ROOT = ($.os.indexOf("Windows") >= 0)
    ? "C:/Program Files/Adobe/Common/Plug-ins/7.0/MediaCore/minColor"
    : "/Library/Application Support/Adobe/Common/Plug-ins/7.0/MediaCore/minColor";
  function centralConfigs() { return CENTRAL_ROOT + "/configs"; }
  var OCIO_ENGINE_VERSION = "2.5.2";                                 // static OCIO linked into the MINC plugin (keep in sync with plugin/external/build.sh TAG)
  function pluginBundleVersion() {                                   // installed plugin version, or null
    try {
      if ($.os.indexOf("Windows") >= 0) {                            // the Windows build drops version.txt beside the .aex
        var vt = new File(CENTRAL_ROOT + "/version.txt");
        if (!vt.exists) return null;
        vt.open("r"); var v = vt.read(); vt.close();
        return v.replace(/^\s+|\s+$/g, "") || null;
      }
      var plist = new File(CENTRAL_ROOT + "/minColorCST.plugin/Contents/Info.plist");
      if (!plist.exists) return null;
      plist.open("r"); var s = plist.read(); plist.close();
      var m = s.match(/CFBundleVersion<\/key>\s*<string>([^<]+)/);
      return m ? m[1] : null;
    } catch (e) { return null; }
  }
  function stampProvenance(presetKey, configBase) {                   // archival record INSIDE the .aep (XMP packet)
    try {
      var d = new Date();
      function z(n) { return (n < 10 ? "0" : "") + n; }
      var rec = '{"tool":"minColor","panel":"' + VERSION + '","plugin":"' + (pluginBundleVersion() || "none") +
                '","ocioEngine":"' + OCIO_ENGINE_VERSION + '","preset":"' + presetKey + '","config":"' + configBase +
                '","date":"' + d.getFullYear() + "-" + z(d.getMonth() + 1) + "-" + z(d.getDate()) + '"}';
      var xmp = app.project.xmpPacket;
      var block = '<rdf:Description rdf:about="" xmlns:minColor="https://bialkow.ski/minColor/ns/">' +
                  '<minColor:provenance>' + rec.replace(/&/g, "&amp;").replace(/</g, "&lt;") + '</minColor:provenance></rdf:Description>';
      if (xmp.indexOf("minColor:provenance") >= 0)
        /* AE normalizes the packet on store — replace only the inner element, formatting-agnostic */
        xmp = xmp.replace(/(<minColor:provenance>)[^<]*(<\/minColor:provenance>)/,
                          "$1" + rec.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/\$/g, "$$$$") + "$2");
      else
        xmp = xmp.replace("</rdf:RDF>", block + "</rdf:RDF>");
      app.project.xmpPacket = xmp;
      return rec;
    } catch (e) { return null; }                                      // provenance is best-effort, never blocks a ceremony
  }
  function readProvenance() {
    try {
      var m = app.project.xmpPacket.match(/<minColor:provenance>([^<]*)<\/minColor:provenance>/);
      return m ? m[1].replace(/&lt;/g, "<").replace(/&amp;/g, "&") : null;
    } catch (e) { return null; }
  }
  function stampEngine(engine) {                                     // "native" | "plugin", tracked in project XMP (cheap heartbeat reads)
    try {
      var xmp = app.project.xmpPacket;
      if (xmp.indexOf("minColor:engine") >= 0)
        xmp = xmp.replace(/(<minColor:engine>)[^<]*(<\/minColor:engine>)/, "$1" + engine + "$2");
      else
        xmp = xmp.replace("</rdf:RDF>", '<rdf:Description rdf:about="" xmlns:minColor="https://bialkow.ski/minColor/ns/"><minColor:engine>' + engine + '</minColor:engine></rdf:Description></rdf:RDF>');
      app.project.xmpPacket = xmp;
    } catch (e) {}
  }
  function readEngine() {
    try { var m = app.project.xmpPacket.match(/<minColor:engine>([^<]*)<\/minColor:engine>/); return m ? m[1] : null; } catch (e) { return null; }
  }
  function stampHarvest(json) {                                      // stripped-assignment provenance INSIDE the .aep (was _minColor/harvest.json)
    try {
      var xmp = app.project.xmpPacket;
      var enc = json.replace(/&/g, "&amp;").replace(/</g, "&lt;");
      if (xmp.indexOf("minColor:harvest") >= 0)
        xmp = xmp.replace(/(<minColor:harvest>)[^<]*(<\/minColor:harvest>)/, "$1" + enc.replace(/\$/g, "$$$$") + "$2");
      else
        xmp = xmp.replace("</rdf:RDF>", '<rdf:Description rdf:about="" xmlns:minColor="https://bialkow.ski/minColor/ns/"><minColor:harvest>' + enc + '</minColor:harvest></rdf:Description></rdf:RDF>');
      app.project.xmpPacket = xmp;
    } catch (e) {}
  }
  function pinConfig(presetKey) {                                    // preferred pin target for a preset (retired presets resolve too)
    var pr = presetMeta(presetKey); if (!pr) throw new Error("unknown preset " + presetKey);
    var central = new File(centralConfigs() + "/" + pr.config);
    if (central.exists) return central.fsName;
    return ensureSidecar(presetKey);                                 // central store not installed -> classic sidecar
  }
  function ensureSidecar(presetKey) {                                // copy config (+luts) next to the project; returns pinned path
    var sd = sidecarDir(); if (!sd) throw new Error("save the project first");
    var pr = presetMeta(presetKey); if (!pr) throw new Error("unknown preset " + presetKey);
    var root = payloadRoot();
    var dst = new Folder(sd); if (!dst.exists) dst.create();
    for (var d = 0, dirs = ["luts", "filmic", "icc"]; d < dirs.length; d++)
      if (new Folder(root + "/" + dirs[d]).exists) copyTree(root + "/" + dirs[d], sd + "/" + dirs[d]);
    var cfgTarget = new File(sd + "/" + pr.config);
    if (!cfgTarget.exists) { if (!new File(root + "/" + pr.config).copy(cfgTarget.fsName)) throw new Error("config copy failed"); }
    // minColor.json v2: sidecars are shared by the FOLDER but entries are per PROJECT file —
    // two unrelated projects in one folder (e.g. Desktop) must never claim each other's setup
    var j = {}; try { j = readJSON(sd + "/minColor.json"); } catch (eJ) {}
    var projects = j.projects || {};
    projects[app.project.file.displayName] = { preset: presetKey, config: pr.config, panel: VERSION };
    function esc(s) { return String(s).replace(/\\/g, "\\\\").replace(/"/g, '\\"'); }
    var parts = [];
    for (var pk in projects) if (projects[pk] && projects[pk].config) parts.push('"' + esc(pk) + '": { "preset": "' + esc(projects[pk].preset) + '", "config": "' + esc(projects[pk].config) + '", "panel": "' + esc(projects[pk].panel || VERSION) + '" }');
    var mf = new File(sd + "/minColor.json"); mf.open("w");
    mf.write('{ "projects": {\n  ' + parts.join(",\n  ") + '\n} }'); mf.close();
    return cfgTarget.fsName;
  }
  var CONFIG_PATTERN = /config-([A-Za-z0-9]+)-[0-9a-f]+\.ocio$/;
  function sidecarInfo() {                                           // pin-anywhere recognition: identity comes from the hashed FILENAME
    var p2 = app.project;
    var cfg = (p2.ocioConfigurationFile || "").replace(/\\/g, "/");
    var m = cfg.match(CONFIG_PATTERN);
    if (m) {
      var base = cfg.substring(cfg.lastIndexOf("/") + 1);
      return { preset: m[1], configPath: new File(cfg).exists ? cfg : null, config: base, pinned: cfg };
    }
    /* pointer empty or foreign — AE WIPES the pin when the stored path does not exist (cross-platform
       arrival: a Windows pin opened on mac, or vice versa). Provenance inside the .aep is the portable
       identity carrier: recover preset + hashed config filename from it. */
    var prov = readProvenance();
    if (prov) {
      try {
        var pj = eval("(" + prov + ")");
        if (pj && pj.config && pj.preset) return { preset: pj.preset, configPath: findConfigByName(pj.config), config: pj.config, pinned: null };
      } catch (eP) {}
    }
    /* legacy fallback: the pre-central sidecar listing */
    var sd = p2.file ? p2.file.parent.fsName + "/_minColor" : null;
    if (sd && new File(sd + "/minColor.json").exists) {
      try {
        var j = readJSON(sd + "/minColor.json");
        var key = p2.file ? p2.file.displayName : null;
        var ent = (j.projects && key && j.projects[key]) ? j.projects[key] : null;
        if (ent) { var cf = new File(sd + "/" + ent.config); return { preset: ent.preset, configPath: cf.exists ? cf.fsName : null, config: ent.config, pinned: null }; }
      } catch (eJ) {}
    }
    return null;
  }
  function findConfigByName(base) {                                  // filename-match search: central, project sidecar, dev payload
    var cands = [centralConfigs() + "/" + base];
    var p2 = app.project;
    if (p2.file) cands.push(p2.file.parent.fsName + "/_minColor/" + base);
    try { cands.push(payloadRoot() + "/" + base); } catch (ePr) {}
    for (var i = 0; i < cands.length; i++) if (new File(cands[i]).exists) return new File(cands[i]).fsName;
    return null;
  }
  function doctor() {                                                // diagnose; returns {status:"green"|"yellow"|"red"|"unmanaged", text, canRepair}
    var p2 = app.project, info = sidecarInfo();
    if (!info) return { status: "unmanaged", text: p2.file ? "not a minColor project (no pin, provenance, or sidecar)" : "unsaved project", canRepair: false, preset: null, family: "Linear" };
    var pr = presetMeta(info.preset) || null, fam = familyFor(info.preset);
    var cfgOk = new File(p2.ocioConfigurationFile).exists && p2.ocioConfigurationFile === info.configPath;
    var cmsOk = (p2.colorManagementSystem === 1);
    var wsOk = pr ? (p2.workingSpace === pr.workingSpaceLabel) : (p2.workingSpace !== "None");
    if (cmsOk && cfgOk && wsOk) {
      // guard the single-authority invariant too: footage level must stay NOTHING (reads the last-saved
      // file — no forced save; a manual assignment shows up after the next save at the latest)
      try {
        if (p2.file && p2.file.exists) {
          var a = AEPPatch.readAssignments(p2.file.fsName);
          var byId = {}; for (var ai = 0; ai < a.items.length; ai++) if (a.items[ai].id !== null) byId[a.items[ai].id] = a.items[ai];
          var wn = a.working ? a.working.replace(/^[^\/]*\//, "") : "?";
          var bad = 0;
          for (var pj = 1; pj <= p2.numItems; pj++) {
            var pit = p2.item(pj);
            if (!(pit instanceof FootageItem) || !(pit.mainSource instanceof FileSource) || !pit.mainSource.file) continue;
            var rec = byId[pit.id]; if (!rec) continue;
            var cn = rec.colorspace.replace(/^[^\/]*\//, "");
            if (cn !== wn && cn !== "default") bad++;
          }
          if (bad > 0) return { status: "red", text: bad + " footage item(s) carry footage-level assignments — run Set Up / Migrate to strip", canRepair: false, preset: info.preset, family: fam };
        }
      } catch (eAud) {}
      var locus = ((p2.ocioConfigurationFile || "").indexOf(CENTRAL_ROOT) === 0) ? "central" : "sidecar";
      var behind = pinBehind();
      if (behind) return { status: "yellow", text: info.preset + " · pinned " + behind.pinned.replace(/^config-|\.ocio$/g, "") + " \u2192 update available (" + behind.current.replace(/^config-|\.ocio$/g, "") + "): Set Up / Migrate, same preset", canRepair: false, preset: info.preset, family: fam, pinBehind: behind };
      return { status: "green", text: info.preset + (pr && pr.retired ? " (retired)" : "") + " · " + p2.workingSpace + " · " + locus, canRepair: false, preset: info.preset, family: fam };
    }
    if (!wsOk) return { status: "red", text: "working space is " + p2.workingSpace + " (want " + (pr ? pr.workingSpaceLabel : "?") + ") — run Set Up / Migrate", canRepair: false, preset: info.preset, family: fam };
    return { status: "yellow", text: (!cmsOk ? "engine fell back to Adobe mode; " : "") + (!cfgOk ? "config path needs re-pointing" : ""), canRepair: (info.configPath !== null) || (findConfigByName(info.config) !== null), preset: info.preset, family: fam };
  }
  function repair() {                                                // one-click / auto: re-point at any local copy of the SAME hashed config
    var p2 = app.project, info = sidecarInfo();
    if (!info || !info.config) throw new Error("no repairable minColor pin found");
    var target = info.configPath || findConfigByName(info.config);
    if (!target) throw new Error("config '" + info.config + "' not found locally (central store, sidecar, payload)");
    if (p2.colorManagementSystem !== 1) p2.colorManagementSystem = 1;
    p2.ocioConfigurationFile = target;
    var d2 = doctor();
    if (d2.status !== "green") throw new Error("repair incomplete: " + d2.text);
    try { syncPluginNames(); } catch (eSy) {}                        // refresh MINC registry against the healed authority
    try { app.purge(PurgeTarget.ALL_CACHES); } catch (ePu) {}        // cached frames predate the heal — without this the viewer
    return "repaired \u2192 " + target;                             // keeps showing pre-heal pixels and looks like it needs a restart
  }
  function preflight() {
    var r = { ok: true, notes: [] };
    function need(cond, msg) { if (!cond) { r.ok = false; r.notes.push("FAIL " + msg); } }
    var p = app.project;
    need(typeof p.colorManagementSystem !== "undefined", "colorManagementSystem missing (AE build change?)");
    need(typeof p.ocioConfigurationFile !== "undefined", "ocioConfigurationFile missing (AE build change?)");
    try { need(app.effects.length > 0, "app.effects unavailable"); } catch (e) { need(false, "app.effects threw"); }
    var haveCST = false;
    for (var i = 0; i < app.effects.length; i++) if (app.effects[i].matchName === "ADBE OCIO Color Space Transform") haveCST = true;
    need(haveCST, "native OCIO Color Space Transform not installed");
    if (p.colorManagementSystem === 1) need(p.workingSpace !== "None", "OCIO mode but working space is None (colour management effectively off)");
    return r;
  }

  function seedStickyPref(presetKey) {
    var pr = presets()[presetKey]; if (!pr) throw new Error("unknown preset " + presetKey);
    var orig = app.preferences.getPrefAsString(STICKY_SEC, STICKY_KEY, PREFType.PREF_Type_MACHINE_INDEPENDENT);
    var neu = orig.replace(/(<PwCs bdata="01"\/>\s*<string>)\{[^<]*\}(<\/string>)/, "$1" + pr.pwcsJSON + "$2");
    neu = neu.replace(/(<pcms bdata="01"\/>\s*<string>)[^<]*(<\/string>)/,
      '$1{"colorManagementSystem":1,"ocioConfigurationFile":"' + (payloadRoot() + "/" + pr.config) + '"}$2');
    if (neu === orig && orig.indexOf(pr.pwcsJSON) < 0) throw new Error("sticky pref shape not recognized — AE build change? aborting");
    app.preferences.savePrefAsString(STICKY_SEC, STICKY_KEY, neu, PREFType.PREF_Type_MACHINE_INDEPENDENT);
    app.preferences.saveToDisk();
    return pr;
  }

  function newProject(presetKey, opts) {
    var p0 = app.project;
    if (p0.dirty) {                                                 // never let app.newProject() raise a modal save prompt
      if (p0.file) p0.save();
      else throw new Error("the current untitled project has unsaved changes — save or close it first");
    }
    var pr = seedStickyPref(presetKey);
    app.newProject();
    var p = app.project;
    if (p.colorManagementSystem !== 1) p.colorManagementSystem = 1;
    p.ocioConfigurationFile = payloadRoot() + "/" + pr.config;      // bootstrap config (not carried by the pref); re-pinned to sidecar below
    try { p.bitsPerChannel = 32; } catch (e) {}                     // 16 must be set in the UI (setter quirk)
    p.compensateForSceneReferredProfiles = false;
    // a minColor project needs a file (sidecar home); ask where it lives, then pin the sidecar config
    if (!p.file) {
      if (opts && opts.interactive) { if (!p.saveWithDialog()) throw new Error("save cancelled — project not set up"); }
      else p.save(new File(Folder.temp.fsName + "/minColor_new_" + (new Date()).getTime() + ".aep"));
      p = app.project;
    }
    var pinned = pinConfig(presetKey);
    try { stampProvenance(presetKey, presets()[presetKey].config); } catch (eSt2) {}
    if (!readEngine()) stampEngine("native");
    p.ocioConfigurationFile = pinned;
    if (p.workingSpace !== pr.workingSpaceLabel) {
      // AE resolved the seeded working space against its DEFAULT config and dropped it (RESULTS 15):
      // recover via save -> patch -> reopen against the sidecar-pinned project
      p.save();
      AEPPatch.patchFile(p.file.fsName, { working: { name: pr.working, family: pr.family } });
      app.beginSuppressDialogs(); app.open(new File(p.file.fsName)); app.endSuppressDialogs(false);
      p = app.project;
    }
    return { preset: presetKey, working: p.workingSpace, config: p.ocioConfigurationFile, file: p.file ? p.file.fsName : null };
  }
  function assertProject(presetKey) {                               // re-assert on open; never touches workingSpace
    var pr = presets()[presetKey]; var p = app.project; var fixed = [];
    if (p.colorManagementSystem !== 1) { p.colorManagementSystem = 1; fixed.push("cms"); }
    var info = sidecarInfo();
    var want = info && info.configPath ? info.configPath : (payloadRoot() + "/" + pr.config);
    if (p.ocioConfigurationFile !== want) { p.ocioConfigurationFile = want; fixed.push("config"); }
    if (p.workingSpace !== pr.workingSpaceLabel) fixed.push("WORKING SPACE MISMATCH: " + p.workingSpace + " (want " + pr.workingSpaceLabel + " — use Sync Apply or the dialog)");
    return fixed;
  }

  function rebuildMinColorEffects() {                                // re-create every minColor CST fresh under the CURRENT config.
    // Effects carry per-instance config state (incl. the absolute config path) from when they were
    // added; after a preset switch that stale state can hard-crash AE inside
    // OCIOWrapper::ValidateOCIOColorSpace. Names encode intent:
    // "minColor: view X" / "minColor: render X" / "minColor: X \u2192 working".
    var p = app.project, out = { rebuilt: [], failed: [], foreign: [], viewRender: 0, orphans: [], strippedPipeline: [], gradesLeft: [], remapped: [], removed: [] };   // foreign = CSTs we did not add (can't reconstruct intent; same stale-config crash risk)
    var ctx = suggestCtx(), touchedMinc = false;                     // names are remapped to THIS preset's spaces before re-adding
    $.global.__minColorViewerId = null;
    for (var i = 1; i <= p.numItems; i++) {
      var it = p.item(i); if (!(it instanceof CompItem)) continue;
      for (var L = 1; L <= it.numLayers; L++) {
        var ly = it.layer(L), fxp = null;
        try { fxp = ly.property("ADBE Effect Parade"); } catch (e0) { continue; }
        if (!fxp) continue;
        if (ly.adjustmentLayer && /^minColor (VIEW|RENDER)/.test(ly.name)) {   /* stacking-bug artifact: host solid with no minColor CST */
          var hasOurs = false;
          for (var oc = 1; oc <= fxp.numProperties; oc++) if (fxp.property(oc).name.indexOf(FX_PREFIX) === 0) { hasOurs = true; break; }
          if (!hasOurs) out.orphans.push(it.name + "/" + ly.name);
        }
        for (var k = 1; k <= fxp.numProperties; k++) {
          var nm = fxp.property(k).name;
          var mn0 = fxp.property(k).matchName;
          /* migrate policy (2026-08-27): pipeline OCIO effects outside minColor are competition +
             stale-config crash bait -> STRIP (project is backed up; every removal reported).
             CDL = a grade, FILE = a look: CONTENT -> rebuild in place with values copied.       */
          if (mn0 === "ADBE OCIO Look Transform" && nm.indexOf(FX_PREFIX) === 0) {
            /* OUR look, native dialect (translate output): meaning lives in the name; the look
               popup is unreadable from scripting, so leave in place and report for review. */
            if (!ctx.hasLooks) {                                     // display-referred presets have no looks: remove, report
              try { var wlk = ly.locked; if (wlk) ly.locked = false; try { fxp.property(k).remove(); } finally { if (wlk) ly.locked = true; } out.removed.push(it.name + "/" + ly.name + " [" + nm + "] \u2014 looks do not exist in this preset"); k--; }
              catch (eLk) { out.failed.push(it.name + "/" + ly.name + " [" + nm + "] \u2014 " + eLk.toString()); }
              continue;
            }
            out.gradesLeft.push(it.name + "/" + ly.name + " [" + nm + "]");
            continue;
          }
          if (mn0 === MINC_MATCH && nm.indexOf(FX_PREFIX) === 0) {    /* plugin dialect: meaning IS the name — remap it to this preset's spaces */
            var pm = parseFxName(nm), lblM = it.name + "/" + ly.name;
            if (!pm) continue;
            if (pm.kind === "look") {
              if (!ctx.hasLooks) { try { var wlm = ly.locked; if (wlm) ly.locked = false; try { fxp.property(k).remove(); } finally { if (wlm) ly.locked = true; } out.removed.push(lblM + " [" + nm + "] \u2014 looks do not exist in this preset"); k--; } catch (eLm) { out.failed.push(lblM + " \u2014 " + eLm.toString()); } }
              continue;
            }
            var rm = remapSpace(pm.kind, pm.space, ctx);
            if (rm.space === null) { try { var wln = ly.locked; if (wln) ly.locked = false; try { fxp.property(k).remove(); } finally { if (wln) ly.locked = true; } (rm.identity ? out.remapped : out.failed).push(lblM + " \u2014 " + rm.note + (rm.identity ? "" : " (removed; re-interpret)")); k--; } catch (eRn) { out.failed.push(lblM + " \u2014 " + eRn.toString()); } continue; }
            if (rm.changed) { try { var wlr = ly.locked; if (wlr) ly.locked = false; try { fxp.property(k).name = fxName(pm.kind, rm.space); stampSerial(fxp.property(k)); } finally { if (wlr) ly.locked = true; } out.remapped.push(lblM + ": " + rm.note); touchedMinc = true; } catch (eRm) { out.failed.push(lblM + " \u2014 " + eRm.toString()); } }
            continue;
          }
          if (mn0 === "ADBE OCIO Display Transform" || mn0 === "ADBE OCIO Look Transform" ||
              (mn0 === "ADBE OCIO Color Space Transform" && nm.indexOf(FX_PREFIX) !== 0)) {
            var desc = it.name + "/" + ly.name + " [" + nm + "]";
            try {
              var wl1 = ly.locked; if (wl1) ly.locked = false;
              try { fxp.property(k).remove(); } finally { if (wl1) ly.locked = true; }
              out.strippedPipeline.push(desc); k--;
            } catch (eS) { out.failed.push(desc + " \u2014 " + eS.toString()); }
            continue;
          }
          if (mn0 === "ADBE OCIO CDL Transform" || mn0 === "ADBE OCIO FILE Transform") {
            /* file-driven grade/look: the File path param is unreadable from scripting, so a
               rebuild would destroy the reference. They also cite files, not config colorspace
               names — not the validator-crash class. LEAVE UNTOUCHED, report for review. */
            out.gradesLeft.push(it.name + "/" + ly.name + " [" + nm + "]");
            continue;
          }
          if (mn0 !== "ADBE OCIO Color Space Transform") continue;
          var label = it.name + "/" + ly.name, rest = nm.substring(FX_PREFIX.length);
          try {
            var wasLocked = ly.locked; if (wasLocked) ly.locked = false;
            try {
              var mView = rest.match(/^(view|render) (.+)$/);
              if (mView) {
                /* retarget IN PLACE on the same host layer (remove-then-upsert = the stacking bug) */
                var rv = remapSpace(mView[1], mView[2], ctx);        // view/render always resolve (family default as last resort)
                if (rv.changed) out.remapped.push(label + ": " + rv.note);
                var idxV = k;
                fxp.property(k).remove();
                if ($.global.__minColorViewerId !== it.id) { it.openInViewer(); $.global.__minColorViewerId = it.id; }
                var vfx = fxp.addProperty("ADBE OCIO Color Space Transform");
                vfx.name = fxName(mView[1], rv.space);
                setPopupRetrying(vfx, 1, "default", it);
                setPopupRetrying(vfx, 2, rv.space, it);
                if (vfx.propertyIndex !== idxV) vfx.moveTo(idxV);
                out.viewRender = (out.viewRender || 0) + 1;
              } else {
                var mc = rest.match(/^contain (.+)$/);
                if (mc) {                                            // boundary in native dialect: retarget in place
                  var rc = remapSpace("contain", mc[1], ctx);
                  if (rc.space === null) { fxp.property(k).remove(); out.failed.push(label + " \u2014 " + rc.note + " (removed; re-interpret)"); k--; continue; }
                  if (rc.changed) out.remapped.push(label + ": " + rc.note);
                  var idxC = k;
                  fxp.property(k).remove();
                  if ($.global.__minColorViewerId !== it.id) { it.openInViewer(); $.global.__minColorViewerId = it.id; }
                  var cfx = fxp.addProperty("ADBE OCIO Color Space Transform");
                  cfx.name = fxName("contain", rc.space);
                  setPopupRetrying(cfx, 1, rc.space, it);
                  setPopupRetrying(cfx, 2, "default", it);
                  if (cfx.propertyIndex !== idxC) cfx.moveTo(idxC);
                  out.rebuilt.push(label + " (" + rest + ")");
                  continue;
                }
                var ai = rest.indexOf(" \u2192 working");
                if (ai <= 0) continue;
                var space = rest.substring(0, ai), idx = k;
                var ri = remapSpace("input", space, ctx);
                if (ri.space === null) { fxp.property(k).remove(); (ri.identity ? out.remapped : out.failed).push(label + " \u2014 " + ri.note + (ri.identity ? "" : " (removed; re-interpret)")); k--; continue; }
                if (ri.changed) out.remapped.push(label + ": " + ri.note);
                fxp.property(k).remove();
                var fx = addInputTransform(ly, ri.space);
                if (fx.propertyIndex !== idx) fx.moveTo(idx);
              }
            } finally { if (wasLocked) ly.locked = true; }
            out.rebuilt.push(label + " (" + rest + ")");
          } catch (e) { out.failed.push(label + " \u2014 " + e.toString()); }
        }
      }
    }
    if (touchedMinc) { try { syncPluginNames(); } catch (eSy) {} }
    return out;
  }

  function packageForAnyAE() {                                       // deliberate exit: Adobe effects + self-contained sidecar + archive artifacts
    var tr = translateEffects("native");
    var inf = sidecarInfo();
    if (inf && app.project.file) app.project.ocioConfigurationFile = ensureSidecar(inf.preset);
    var ar = archiveProject();
    return { translated: tr.converted.length, failed: tr.failed, remapped: tr.remapped || [], removed: tr.removed || [], archive: ar };
  }

  // ---------- archive: materialize everything a future machine needs ----------
  function archiveProject() {
    var p = app.project;
    if (!p.file) throw new Error("save the project first");
    var info = sidecarInfo(); if (!info) throw new Error("not a minColor project");
    var sidecarCfg = ensureSidecar(info.preset);                     // config + luts travel with the job
    var sd = p.file.parent.fsName + "/_minColor";
    var prov = readProvenance() || "{}";
    var pf = new File(sd + "/provenance.json");
    pf.open("w"); pf.write(prov); pf.close();
    /* golden reference frame: a synthetic ramp through the CURRENT engine+config — future
       reopenings diff against it to DETECT drift instead of wondering */
    var golden = "skipped (no _HIDDEN X-Factor 32 output template)";
    try {
      var c = p.items.addComp("__minc_golden", 256, 32, 1.0, 1.0, 25.0);
      c.openInViewer();
      var sol = c.layers.addSolid([0, 0, 0], "ramp", 256, 32, 1.0, 1.0);
      var rampFx = sol.property("ADBE Effect Parade").addProperty("ADBE Ramp");
      rampFx.property(1).setValue([0, 16]); rampFx.property(3).setValue([256, 16]);
      var fx = sol.property("ADBE Effect Parade").addProperty("ADBE OCIO Color Space Transform");
      fx.name = FX_PREFIX + "sRGB \u2192 working";
      setPopupRetrying(fx, 1, "sRGB", c);
      setPopupRetrying(fx, 2, "default", c);
      var rqi = p.renderQueue.items.add(c);
      rqi.applyTemplate("Best Settings"); rqi.timeSpanStart = 0; rqi.timeSpanDuration = c.frameDuration;
      var om = rqi.outputModule(1);
      om.applyTemplate("_HIDDEN X-Factor 32");
      var gpath = sd + "/reference_" + info.preset + "_[#####].psd";
      om.file = new File(gpath);
      app.beginSuppressDialogs(); p.renderQueue.render(); app.endSuppressDialogs(false);
      c.remove();
      golden = "reference_" + info.preset + "_00000.psd";
    } catch (eG) { golden = "skipped (" + eG.toString() + ")"; }
    return { sidecar: sidecarCfg, provenance: pf.fsName, golden: golden };
  }

  // ---------- direct MINC authoring (minColor-only world, 2026-08-27) ----------
  var __mincSerial = Math.floor((new Date()).getTime() % 900000);
  function stampSerial(fx) { try { fx.property("Sync Serial").setValue(++__mincSerial); } catch (eS) {} }
  function syncPluginNames() {
    try { var id = app.findMenuCommandId("minColor: Sync From Names"); if (id) { app.executeCommand(id); stampEngine("plugin"); } } catch (eC) {}
  }

  // ---------- engine translation: native CST <-> MINC CST plugin (stage two) ----------
  var MINC_MATCH = "MINC CST";
  function pluginAvailable() {
    // never iterate app.effects (>10 s at panel boot). The AEGP menu command only exists after the
    // effect's first instantiation (AE defers GLOBAL_SETUP), so check the installed bundle on disk;
    // the menu command is confirmation once the session has touched the effect.
    try { if (app.findMenuCommandId("minColor: Sync From Names") !== 0) return true; } catch (e) {}
    var bin = ($.os.indexOf("Windows") >= 0)
      ? CENTRAL_ROOT + "/minColorCST.aex"
      : CENTRAL_ROOT + "/minColorCST.plugin/Contents/MacOS/minColorCST";
    return new File(bin).exists;
  }
  function translateEffects(target) {                                // "plugin" | "native"
    if (target === "plugin" && !pluginAvailable()) throw new Error("minColor CST plugin not installed");
    var p = app.project, out = { converted: [], skipped: [], failed: [], remapped: [], removed: [] };
    var ctx = suggestCtx();                                          // names are remapped to this preset's spaces while translating
    var serial = Math.floor((new Date()).getTime() % 900000);
    $.global.__minColorViewerId = null;
    for (var i = 1; i <= p.numItems; i++) {
      var it = p.item(i); if (!(it instanceof CompItem)) continue;
      for (var L = 1; L <= it.numLayers; L++) {
        var ly = it.layer(L), fxp = null;
        try { fxp = ly.property("ADBE Effect Parade"); } catch (e0) { continue; }
        if (!fxp) continue;
        for (var k = 1; k <= fxp.numProperties; k++) {
          var prop = fxp.property(k), nm = prop.name;
          if (nm.indexOf(FX_PREFIX) !== 0) continue;
          var label = it.name + "/" + ly.name + " [" + nm + "]";
          try {
            var wasLocked = ly.locked; if (wasLocked) ly.locked = false;
            try {
              if (target === "plugin" && prop.matchName === "ADBE OCIO Look Transform") {
                if (!ctx.hasLooks) { fxp.property(k).remove(); out.removed.push(label + " \u2014 looks do not exist in this preset"); k--; continue; }
                var idxL = k;                                        /* name carries the meaning: "minColor: look X" */
                fxp.property(k).remove();
                if ($.global.__minColorViewerId !== it.id) { it.openInViewer(); $.global.__minColorViewerId = it.id; }
                var lf = fxp.addProperty(MINC_MATCH);
                lf.name = nm;
                lf.property("Sync Serial").setValue(++serial);
                if (lf.propertyIndex !== idxL) lf.moveTo(idxL);      // moveTo INVALIDATES lf
                out.converted.push(label);
              } else if (target === "plugin" && prop.matchName === "ADBE OCIO Color Space Transform") {
                var idx = k;
                fxp.property(k).remove();
                if ($.global.__minColorViewerId !== it.id) { it.openInViewer(); $.global.__minColorViewerId = it.id; }
                var nf = fxp.addProperty(MINC_MATCH);
                var pp = parseFxName(nm), rp = pp ? remapSpace(pp.kind, pp.space, ctx) : null;
                if (rp && rp.changed && rp.space) out.remapped.push(label + ": " + rp.note);
                else if (rp && rp.space === null) out.remapped.push(label + ": " + rp.note + " (name kept \u2014 re-interpret)");
                nf.name = (rp && rp.space) ? fxName(pp.kind, rp.space) : nm;
                nf.property("Sync Serial").setValue(++serial);
                if (nf.propertyIndex !== idx) nf.moveTo(idx);        // moveTo INVALIDATES nf — done with it
                out.converted.push(label);
              } else if (target === "native" && prop.matchName === MINC_MATCH) {
                var rest = nm.substring(FX_PREFIX.length), src2 = null, dst2 = null;
                var mlk = rest.match(/^look (.+)$/);
                if (mlk) {                                           /* probed 2026-08-28: param 2 = Look popup (settable by
                                                                        name); Input/Output color space popups left at their
                                                                        defaults = working-space semantics (pixel-verified) */
                  if (!ctx.hasLooks) { fxp.property(k).remove(); out.removed.push(label + " \u2014 looks do not exist in this preset"); k--; continue; }
                  var idxK = k;
                  fxp.property(k).remove();
                  if ($.global.__minColorViewerId !== it.id) { it.openInViewer(); $.global.__minColorViewerId = it.id; }
                  var nlk = fxp.addProperty("ADBE OCIO Look Transform");
                  nlk.name = nm;
                  setPopupRetrying(nlk, 2, mlk[1], it);
                  if (nlk.propertyIndex !== idxK) nlk.moveTo(idxK);  // moveTo INVALIDATES nlk
                  out.converted.push(label);
                  continue;
                }
                var pn = parseFxName(nm);
                if (!pn) { out.skipped.push(label + " (unparsed name)"); continue; }
                var rn = remapSpace(pn.kind, pn.space, ctx);
                if (rn.space === null && rn.identity) { fxp.property(k).remove(); out.removed.push(label + " \u2014 " + rn.note); k--; continue; }
                if (rn.space === null) { out.skipped.push(label + " (" + rn.note + " \u2014 left as plugin effect)"); continue; }   // never destroy without a replacement
                if (rn.changed) out.remapped.push(label + ": " + rn.note);
                if (pn.kind === "contain" || pn.kind === "input") { src2 = rn.space; dst2 = "default"; } else { src2 = "default"; dst2 = rn.space; }
                var idx2 = k;
                fxp.property(k).remove();
                if ($.global.__minColorViewerId !== it.id) { it.openInViewer(); $.global.__minColorViewerId = it.id; }
                var nfx = fxp.addProperty("ADBE OCIO Color Space Transform");
                nfx.name = fxName(pn.kind, rn.space);
                setPopupRetrying(nfx, 1, src2, it);
                setPopupRetrying(nfx, 2, dst2, it);
                if (nfx.propertyIndex !== idx2) nfx.moveTo(idx2);    // moveTo INVALIDATES nfx
                out.converted.push(label);
              }
            } finally { if (wasLocked) ly.locked = true; }
          } catch (e) { out.failed.push(label + " \u2014 " + e.toString()); }
        }
      }
    }
    /* the engine toggle swaps the EXECUTOR only — semantics live in the names, the config
       lives in the pin, and neither moves here. Packaging for other machines = Archive.  */
    if (target === "plugin") {
      var id = app.findMenuCommandId("minColor: Sync From Names");
      if (id) app.executeCommand(id);
      stampEngine("plugin");
    } else {
      stampEngine("native");
    }
    return out;
  }

  // ---------- backups: timestamped, append-only, human-readable; every patch path uses this ----------
  function backupProject(tag) {
    var p = app.project;
    var bdir = new Folder(p.file.parent.fsName + "/_minColor/backups"); if (!bdir.exists) bdir.create();
    var d = new Date();
    function z(n) { return (n < 10 ? "0" : "") + n; }
    var stamp = "" + d.getFullYear() + z(d.getMonth() + 1) + z(d.getDate()) + "-" + z(d.getHours()) + z(d.getMinutes()) + z(d.getSeconds());
    var base = bdir.fsName + "/" + p.file.name.replace(/\.aep$/i, "") + "_" + tag + "_" + stamp;
    var bpath = base + ".aep", n = 2;
    while (new File(bpath).exists) bpath = base + "-" + (n++) + ".aep";   // same-second ceremonies stay distinct
    if (!p.file.copy(bpath)) throw new Error("backup copy failed");
    return bpath;
  }
  function backupStats() {
    var p = app.project, out = { count: 0, mb: 0 };
    if (!p.file) return out;
    var bdir = new Folder(p.file.parent.fsName + "/_minColor/backups"); if (!bdir.exists) return out;
    var fs = bdir.getFiles("*.aep");
    out.count = fs.length;
    for (var i = 0; i < fs.length; i++) out.mb += fs[i].length / 1048576;
    out.mb = Math.round(out.mb * 10) / 10;
    return out;
  }

  // ---------- apply preset to an existing project (save -> backup -> patch -> reopen) ----------
  function applyPresetToCurrent(presetKey) {
    var pr = presets()[presetKey]; var p = app.project;
    if (!p.file) throw new Error("save the project first");
    p.ocioConfigurationFile = pinConfig(presetKey);
    try { stampProvenance(presetKey, presets()[presetKey].config); } catch (eSt) {}
    p.save();
    var bpath = backupProject("prepatch");
    AEPPatch.patchFile(p.file.fsName, { working: { name: pr.working, family: pr.family } });
    app.beginSuppressDialogs(); app.open(new File(p.file.fsName)); app.endSuppressDialogs(false);
    return { working: app.project.workingSpace, backup: bpath };
  }

  // ---------- sync (report + apply) ----------
  function syncReport() {                                           // migration report: footage state vs NOTHING (single-authority model)
    var p = app.project; if (!p.file) throw new Error("save the project first");
    p.save();
    var a = AEPPatch.readAssignments(p.file.fsName);
    var byId = {};
    for (var i = 0; i < a.items.length; i++) if (a.items[i].id !== null) byId[a.items[i].id] = a.items[i];
    var workName = a.working ? a.working.replace(/^[^\/]*\//, "") : "?";
    var rows = [];
    for (var j = 1; j <= p.numItems; j++) {
      var it = p.item(j);
      if (!(it instanceof FootageItem) || !(it.mainSource instanceof FileSource) || !it.mainSource.file) continue;
      var rec = byId[it.id];
      var cur = rec ? (rec.colorspace + (rec.view ? " (view: " + rec.view + ")" : "")) : "(none)";
      var curName = rec ? rec.colorspace.replace(/^[^\/]*\//, "") : null;
      var isNothing = (!rec) || curName === workName || curName === "default";
      rows.push({ item: it.name, id: it.id, path: it.mainSource.file.fsName, current: cur, wanted: workName,
                  okFlag: isNothing, note: isNothing ? "" : "will be STRIPPED (interpretation belongs on layers)" });
    }
    return { working: a.working, rows: rows };
  }
  function syncApply(rows) {                                        // THE STRIP: set flagged items to the working space (nothing)
    var p = app.project; if (!p.file) throw new Error("save the project first");
    var fixes = [];
    for (var i = 0; i < rows.length; i++) if (!rows[i].okFlag)
      fixes.push({ id: rows[i].id, item: rows[i].item, name: rows[i].wanted, family: familyOf(rows[i].wanted) });
    if (!fixes.length) return { applied: 0 };
    p.save();
    var bpath = backupProject("prepatch");
    AEPPatch.patchFile(p.file.fsName, { footage: fixes });
    app.beginSuppressDialogs(); app.open(new File(p.file.fsName)); app.endSuppressDialogs(false);
    return { applied: fixes.length, backup: bpath };
  }
  function familyOf(cs) {
    if (/^(ACES|Linear)/.test(cs)) return "Linear";
    if (/Encoded|Gamma/.test(cs)) return "Utility";
    if (/Log|ADX|S-Log|LogC|V-Log|D-Log|CanonLog|BMDFilm|DaVinci|Apple Log/.test(cs)) return "Input";
    if (/Non-Color/.test(cs)) return "Data";
    return "Display";
  }

  // ---------- migration ceremony (one reopen; single-authority: strip footage to nothing) ----------
  function migrateProject(presetKey, opts) {                         // call AFTER the user confirmed the report; opts.utility = {compName, view, render}
    var pr = presets()[presetKey]; if (!pr) throw new Error("unknown preset " + presetKey);
    var p = app.project; if (!p.file) throw new Error("save the project first");
    var rep = syncReport();                                          // also saves; rows carry current assignments
    // persist the harvest BEFORE stripping — into the project XMP (travels with the .aep;
    // _minColor/ now appears only for backups)
    var items = {}, strip = [];
    for (var i = 0; i < rep.rows.length; i++) {
      var r = rep.rows[i];
      if (!r.okFlag) { items[String(r.id)] = { name: r.current }; strip.push({ id: r.id, item: r.item, name: pr.working, family: pr.family }); }
    }
    var first = true, out = "";
    for (var k in items) { out += (first ? "" : ",") + '"' + k + '":{"name":"' + items[k].name.replace(/"/g, "") + '"}'; first = false; }
    stampHarvest('{ "migrated": "' + presetKey + '", "items": {' + out + '} }');
    // one ceremony: sidecar + config + working space + strip, single patch/reopen
    p.ocioConfigurationFile = pinConfig(presetKey);
    try { stampProvenance(presetKey, presets()[presetKey].config); } catch (eSt) {}
    p.save();
    var bpath = backupProject("premigrate");
    AEPPatch.patchFile(p.file.fsName, { working: { name: pr.working, family: pr.family }, footage: strip });
    app.beginSuppressDialogs(); app.open(new File(p.file.fsName)); app.endSuppressDialogs(false);
    var rebuilt = rebuildMinColorEffects();                          // stale-config CSTs from a previous preset can crash AE's validator
    /* the migrated TIMELINE (the comp that was active) gets both utility layers, view enabled —
       the panel's dropdown values are remapped into the NEW preset's family first */
    var utility = null;
    if (opts && opts.utility && opts.utility.compName) {
      try {
        var tc = null;
        for (var ci = 1; ci <= app.project.numItems; ci++) if (app.project.item(ci) instanceof CompItem && app.project.item(ci).name === opts.utility.compName) { tc = app.project.item(ci); break; }
        if (tc) {
          var uctx = suggestCtx();
