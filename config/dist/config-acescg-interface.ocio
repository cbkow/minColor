ocio_profile_version: 2

description: |
  minColor INTERFACE config (ACEScg pivot) — for AE PROJECT SETTINGS only.
  Makes AE a pure neutralizer:
    * scene_linear = ACEScg is the single compositing pivot (the only working-space option).
    * every default_* role points at scene_linear, so UNASSIGNED footage is passed through
      untouched (identity) and minColor's own effects own every colour transform.
    * no view transforms — display is baked on minColor adjustment layers; the viewer stays
      passthrough (the lone "Raw" view).
  This is NOT the effect's config. The minColor effect resolves its full input/look space list
  from its own pinned config via the passport; this file only governs what AE itself does.

name: minColor-interface-acescg
strictparsing: false

roles:
  reference:       ACEScg
  scene_linear:    ACEScg
  rendering:       ACEScg
  compositing_log: ACEScg
  color_timing:    ACEScg
  default:         ACEScg
  default_byte:    ACEScg
  default_float:   ACEScg
  color_picking:   ACEScg
  matte_paint:     ACEScg
  texture_paint:   ACEScg
  data:            Raw

displays:
  none:
    - !<View> {name: Raw, colorspace: Raw}

active_displays: [none]
active_views: [Raw]

colorspaces:
  - !<ColorSpace>
    name: ACEScg
    family: ""
    equalitygroup: ""
    bitdepth: 32f
    description: |
      ACEScg is the reference/pivot in this interface config — identity by construction.
      Real ACEScg semantics live in the effect's full config; here it is just the space AE
      holds and blends pixels in, untransformed.
    isdata: false
    allocation: lg2
    allocationvars: [-8, 5, 0.00390625]

  - !<ColorSpace>
    name: Raw
    family: ""
    equalitygroup: ""
    bitdepth: 32f
    description: Raw data — no transform. Backs the passthrough viewer view.
    isdata: true
    allocation: uniform
