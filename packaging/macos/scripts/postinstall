#!/bin/bash
# Runs as root after the payload landed. Fans the panel out to every AE >= 2025 the console user has
# launched, seeds settings without overwriting, and removes the older per-machine copy if any.
LOG=/var/log/minColor-install.log
exec >>"$LOG" 2>&1
echo "== minColor postinstall $(date) =="
USER_NAME="$(stat -f %Su /dev/console)"; HOME_DIR="$(dscl . -read /Users/"$USER_NAME" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
[ -n "$HOME_DIR" ] || HOME_DIR="/Users/$USER_NAME"
SHARED=/Users/Shared/minColor
PANEL_SRC="$SHARED/panel"
installed=0
for PREFS in "$HOME_DIR/Library/Preferences/Adobe/After Effects/"*/; do
  [ -d "$PREFS" ] || continue
  ver="$(basename "$PREFS")"; major="${ver%%.*}"
  [ "$major" -ge 25 ] 2>/dev/null || { echo "skip AE $ver (< 25)"; continue; }
  DEST="$PREFS/Scripts/ScriptUI Panels"
  mkdir -p "$DEST"
  # clean up the 0.9.x panel before writing the 2.0 shell: same filename, but the old
  # minColor-data payload folder is dead weight the shell never reads
  rm -f "$DEST/minColor.jsx"
  rm -rf "$DEST/minColor-data"
  cp -f "$PANEL_SRC/minColor.jsx" "$DEST/"
  chown -R "$USER_NAME" "$DEST/minColor.jsx"
  echo "panel -> $DEST"; installed=$((installed+1))
done
[ "$installed" -gt 0 ] || echo "WARNING: no After Effects >= 2025 preference folder found for $USER_NAME (launch AE once, then reinstall)"
# ceremonies AEGP: into every installed AE >= 2025 app Plug-ins folder (we run as root)
aegp=0
for APP in "/Applications/Adobe After Effects "*/; do
  [ -d "$APP" ] || continue
  yr="$(basename "$APP" | grep -o '[0-9]\{4\}$')"
  [ -n "$yr" ] && [ "$yr" -ge 2025 ] 2>/dev/null || { echo "skip $(basename "$APP") (< 2025)"; continue; }
  mkdir -p "$APP/Plug-ins"
  rm -rf "$APP/Plug-ins/minColorAEGP.plugin"
  ditto "$SHARED/engine/minColorAEGP.plugin" "$APP/Plug-ins/minColorAEGP.plugin"
  echo "AEGP -> $APP/Plug-ins"; aegp=$((aegp+1))
done
[ "$aegp" -gt 0 ] || echo "WARNING: no Adobe After Effects >= 2025 app found in /Applications"
# settings: seed only what is missing (user choices survive every update)
mkdir -p "$SHARED/settings"
for f in "$SHARED/settings-seed/"*; do [ -e "$SHARED/settings/$(basename "$f")" ] || cp "$f" "$SHARED/settings/"; done
chown -R "$USER_NAME" "$SHARED" 2>/dev/null || true
chmod -R a+rX "$SHARED" "/Library/Application Support/Adobe/Common/Plug-ins/7.0/MediaCore/minColor" 2>/dev/null || true
# quarantine never applies to pkg payloads, but be explicit for the plug-in bundle
xattr -dr com.apple.quarantine "/Library/Application Support/Adobe/Common/Plug-ins/7.0/MediaCore/minColor" 2>/dev/null || true
echo "done"
exit 0
