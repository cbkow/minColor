<?xml version="1.0" encoding="UTF-8"?>
<!-- minColor Windows installer (WiX v5, per-machine MSI). Build with packaging/windows/build.ps1.
     Places the engine (.aex + version.txt) and the config store into Adobe's shared MediaCore
     folder, the panel into every installed After Effects >= 2025 (app-level ScriptUI Panels,
     all users), and seeds the shared settings under ProgramData\minColor.
     Config store rule: append-only. config/dist in git keeps every hashed config ever shipped, so
     each upgrade re-lays the full set and never removes a hash a project may be pinned to. The
     settings seed is Permanent + NeverOverwrite: user choices survive upgrades and uninstall. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="minColor" Manufacturer="Christopher Bialkowski" Version="$(var.Version)" Language="1033"
           Scope="perMachine" Compressed="yes" UpgradeCode="3F332F15-A3F0-4B8E-80F7-56480572A9F2">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer minColor is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- refuse to install while After Effects is open (the plug-in file is mapped) -->
    <util:CloseApplication Target="AfterFX.exe" CloseMessage="no" PromptToContinue="yes" RebootPrompt="no"
                           Description="After Effects is running. Quit it, then continue." />

    <!-- After Effects install roots. Verified on Windows 11 / AE 2026 (26.3), 2026-08-29:
         HKLM\SOFTWARE\Adobe\After Effects\26.0  InstallPath = C:\Program Files\Adobe\Adobe After Effects 2026\Support Files\
         (also PluginInstallPath, CommonPluginInstallPath = ...\Common\Plug-ins\7.0\MediaCore\, FFXInstallPath). No WOW6432Node mirror.
         InstallPath already ENDS IN "Support Files\", so the panel trees below start at Scripts\.
         The AE roots carry a fallback Name only so their auto component GUIDs differ; the registry value overrides the path. -->
    <Property Id="AE2025DIR"><RegistrySearch Root="HKLM" Key="SOFTWARE\Adobe\After Effects\25.0" Name="InstallPath" Type="directory" /></Property>
    <Property Id="AE2026DIR"><RegistrySearch Root="HKLM" Key="SOFTWARE\Adobe\After Effects\26.0" Name="InstallPath" Type="directory" /></Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Name="Adobe"><Directory Name="Common"><Directory Name="Plug-ins"><Directory Name="7.0"><Directory Name="MediaCore">
        <Directory Id="MINCOLORDIR" Name="minColor"><Directory Id="MINCONFIGS" Name="configs" /></Directory>
      </Directory></Directory></Directory></Directory></Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PDMINCOLOR" Name="minColor">
        <Directory Id="PDCONFIGS" Name="configs" />
        <Directory Id="PDSETTINGS" Name="settings" />
      </Directory>
    </StandardDirectory>
    <Directory Id="AE2025DIR" Name="AE2025"><Directory Name="Scripts"><Directory Id="AE2025PANELS" Name="ScriptUI Panels"><Directory Id="AE2025DATA" Name="minColor-data" /></Directory></Directory></Directory>
    <Directory Id="AE2026DIR" Name="AE2026"><Directory Name="Scripts"><Directory Id="AE2026PANELS" Name="ScriptUI Panels"><Directory Id="AE2026DATA" Name="minColor-data" /></Directory></Directory></Directory>

    <!-- engine. The .aex carries no VERSIONINFO resource, so MSI would treat it as a data file and keep any
         pre-existing copy whose mtime != ctime ("unversioned but modified" — every dev-install / zip copy).
         DefaultVersion (= prebuilt version.txt) makes MSI compare versions instead and lay the engine down. -->
    <ComponentGroup Id="Engine" Directory="MINCOLORDIR">
      <Component><File Source="$(var.Prebuilt)\minColorCST.aex" DefaultVersion="$(var.EngineVersion)" /></Component>
      <Component><File Source="$(var.Prebuilt)\version.txt" DefaultVersion="$(var.EngineVersion)" />
        <!-- folders a dev-install / zip created before the MSI owned them are not MSI's to remove; sweep them if empty -->
        <RemoveFolder Id="RmMinConfigs" Directory="MINCONFIGS" On="uninstall" />
        <RemoveFolder Id="RmMinColorDir" Directory="MINCOLORDIR" On="uninstall" />
        <RemoveFolder Id="RmPdConfigs" Directory="PDCONFIGS" On="uninstall" />
      </Component>
    </ComponentGroup>
    <!-- config store beside the engine (the plug-in's passport resolves against it) + the shared copy.
         WiX harvests a given source path only once (WIX8602 silently drops the repeat), so every tree that
         lands in two places is harvested from its own staged copy — build.ps1 lays them out under dist-panel\msi-stage. -->
    <ComponentGroup Id="ConfigsCentral" Directory="MINCONFIGS"><Files Include="$(var.ConfigsCentral)\**" /></ComponentGroup>
    <ComponentGroup Id="ConfigsShared" Directory="PDCONFIGS"><Files Include="$(var.ConfigsShared)\**" /></ComponentGroup>
    <!-- settings seed: never overwritten, never removed -->
    <ComponentGroup Id="Settings" Directory="PDSETTINGS">
      <Component Permanent="yes" NeverOverwrite="yes"><File Source="$(var.Config)\extension-defaults.json" /></Component>
      <Component Permanent="yes" NeverOverwrite="yes"><File Source="$(var.Config)\render-presets.json" /></Component>
    </ComponentGroup>
    <!-- panel per installed AE. Gated by feature level, not component conditions: <Files> (the harvested
         minColor-data tree) cannot carry a Condition, and a level-0 feature keeps the whole group out. -->
    <ComponentGroup Id="Panel2025">
      <Component Directory="AE2025PANELS"><File Source="$(var.Panel2025)\minColor.jsx" /></Component>
      <Files Include="$(var.Panel2025)\minColor-data\**" Directory="AE2025DATA" />
    </ComponentGroup>
    <ComponentGroup Id="Panel2026">
      <Component Directory="AE2026PANELS"><File Source="$(var.Panel2026)\minColor.jsx" /></Component>
      <Files Include="$(var.Panel2026)\minColor-data\**" Directory="AE2026DATA" />
    </ComponentGroup>

    <Feature Id="Main" Title="minColor" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="Engine" /><ComponentGroupRef Id="ConfigsCentral" /><ComponentGroupRef Id="ConfigsShared" />
      <ComponentGroupRef Id="Settings" />
      <Feature Id="PanelAE2025" Title="Panel for After Effects 2025" Level="0"><Level Value="1" Condition="AE2025DIR" /><ComponentGroupRef Id="Panel2025" /></Feature>
      <Feature Id="PanelAE2026" Title="Panel for After Effects 2026" Level="0"><Level Value="1" Condition="AE2026DIR" /><ComponentGroupRef Id="Panel2026" /></Feature>
    </Feature>
  </Package>
</Wix>
